{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    /* WebWorker instead of DOM: the two libs cannot be combined (duplicate
       global declarations), which is why the worker needs its own project
       rather than living in tsconfig.app.json. */
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    /* vite/client は ocrWorker の `?url` import と import.meta.env の型のために
       必要。vite/client は DOM lib を参照しないので WebWorker lib と併用できる。 */
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/workers/exportWorker.ts", "src/workers/ocrWorker.ts"]
}
