{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    // DOM is here for the Playwright specs: the callbacks passed to
    // page.evaluate are serialized and run inside the browser, so they need
    // DOM globals even though the file itself runs under Node.
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,

    /* Bundler mode: Playwright and Vite both resolve extensionless relative
       imports (e2e/full-flow.spec.ts imports './makeTinyPng'), which
       nodenext resolution rejects. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
